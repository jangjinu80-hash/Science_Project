  m_Name: Stage14
  m_EditorClassIdentifier: Assembly-CSharp::JJW.Code.Player.StageDefinition
  number: 14
  title: "\uBA3C\uC800 \uBC30\uCE58\uD558\uAE30"
  objective: "\uBB34\uAC70\uC6B4 \uC0C1\uC790 \uB450 \uAC1C\uB85C A\uC640 B\uB97C
    \uC900\uBE44\uD55C \uB4A4, \uB9C8\uC9C0\uB9C9 \uCDA9\uC804\uACFC \uD1B5\uACFC
    \uC21C\uC11C\uB97C \uC815\uD558\uC138\uC694."
  hint: "\uAC00\uBCBC\uC6B4 \uC0C1\uC790\uB294 \uBB34\uAC8C 3 \uBC1C\uD310\uC744
    \uB300\uC2E0\uD560 \uC218 \uC5C6\uC5B4\uC694. \uBA3C\uC800 \uB450 \uBC1C\uD310\uC744
    \uC900\uBE44\uD558\uBA74 \uAE09\uC18D\uD615\uC744 \uCDA9\uC804\uD55C \uCC44 \uAE30\uB2E4\uB9AC\uB294
    \uC2DC\uAC04\uC744 \uC904\uC77C \uC218 \uC788\uC5B4\uC694."
  supply: 62
  capacitorCount: 3
  question: "\uCDA9\uC804\uB41C \uBAA8\uB4C8\uC5D0 \uC2DC\uAC04\uC5D0 \uB530\uB978
    \uC190\uC2E4\uC774 \uC788\uB294 \uC774 \uAC8C\uC784\uC5D0\uC11C\uB294, \uC0C1\uC790\uB97C
    \uBA3C\uC800 \uBC30\uCE58\uD55C \uB4A4 \uCDA9\uC804\uD558\uBA74 \uC774\uB3D9
    \uC911 \uBD88\uD544\uC694\uD55C \uC190\uC2E4\uC744 \uC904\uC77C \uC218 \uC788\uB2E4."
  answer: 1
  explanation: "\uAC19\uC740 \uC77C\uC744 \uD558\uB354\uB77C\uB3C4 \uCDA9\uC804\uB41C
    \uC0C1\uD0DC\uB85C \uAE30\uB2E4\uB9AC\uB294 \uC2DC\uAC04\uC774 \uAE38\uBA74 \uAC8C\uC784\uC758
    \uC190\uC2E4\uC774 \uB354 \uC313\uC5EC\uC694. \uBA3C\uC800 \uBC1C\uD310\uACFC
    \uC774\uB3D9 \uACBD\uB85C\uB97C \uC900\uBE44\uD558\uBA74 \uCDA9\uC804 \uD6C4
    \uD544\uC694\uD55C \uD589\uB3D9\uB9CC \uD560 \uC218 \uC788\uC5B4\uC694.\n\uC2E4\uC81C
    \uC190\uC2E4\uC758 \uD06C\uAE30\uB294 \uD68C\uB85C \uC870\uAC74\uC5D0 \uB530\uB77C
    \uB2E4\uB974\uC9C0\uB9CC, \uC800\uC7A5 \uC5D0\uB108\uC9C0\uB97C \uD6A8\uC728\uC801\uC73C\uB85C
    \uC0AC\uC6A9\uD558\uB294 \uACC4\uD68D\uC740 \uC911\uC694\uD574\uC694."
