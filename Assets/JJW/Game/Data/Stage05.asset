  supply: 56
  capacitorCount: 2
  question: "\uC800\uC7A5 \uC5D0\uB108\uC9C0\uAC00 \uB9CE\uC740 \uAC83\uACFC, \uC9E7\uC740
    \uC2DC\uAC04\uC5D0 \uD070 \uC5D0\uB108\uC9C0\uB97C \uC804\uB2EC\uD560 \uC218
